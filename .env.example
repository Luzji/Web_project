# Blockchain
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
WEB3_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
BACKEND_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CONTRACT_ADDRESS=
CHAIN_START_BLOCK=0

# FastAPI
ENV=development  # đổi thành production khi deploy
# Bắt buộc tạo secret riêng: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=sqlite:///./mediaguard.db
JWT_SECRET=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
VERIFY_RATE_LIMIT=30
AUTH_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: lưu file upload trên Cloudinary (dùng khi deploy, nơi ổ đĩa không bền).
# Để trống cả ba biến thì backend lưu file vào UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
